# Server
PORT=5000
NODE_ENV="development"
API_URL="http://localhost:5000"

# CORS URLs
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/unseen_gadget?sslmode=require"

# JWT Authentication (Required: at least 32 characters)
JWT_SECRET="your-super-strong-jwt-secret-at-least-32-characters-long"
JWT_EXPIRES_IN="7d"

# Media Storage (Cloudinary - Required for product image uploads)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Default Super Admin Seed Credentials
ADMIN_EMAIL="admin@unseengadget.com"
ADMIN_PASSWORD="YourStrongAdminPassword123!"

# Email Service (SMTP / Nodemailer - Optional: defaults to Dev console mode if empty)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
