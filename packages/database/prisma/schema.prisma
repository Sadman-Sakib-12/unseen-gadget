generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================== Enums ===========================

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AdminStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum ShippingType {
  FREE
  PAID
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  MOBILE_BANKING
  CASH_ON_DELIVERY
  BANK_TRANSFER
}

enum PaymentGateway {
  STRIPE
  BKASH
  CASH
  BANK
  NAGAD
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  EXPIRED
  INACTIVE
}

enum PromotionType {
  SALE
  FREE_SHIPPING
  BOGO
  BUNDLE
}

enum PromotionApplicableTo {
  ALL
  CATEGORY
  PRODUCT
}

enum PromotionStatus {
  ACTIVE
  ENDED
  SCHEDULED
}

enum DeliveryStatus {
  DELIVERED
  IN_TRANSIT
  PENDING
  PICKED_UP
  CANCELLED
}

enum ReturnStatus {
  REFUNDED
  APPROVED
  PENDING
  REJECTED
}

enum ReviewStatus {
  APPROVED
  PENDING
  REJECTED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum SupplierTransactionType {
  PURCHASE
  PAYMENT
  REFUND
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  DRAFT
  CANCELLED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum ExpenseCategory {
  MARKETING
  INVENTORY
  UTILITIES
  SALARY
  RENT
  LOGISTICS
  MAINTENANCE
  OFFICE_SUPPLIES
  INSURANCE
  MISCELLANEOUS
}

enum NotificationType {
  ORDER
  PAYMENT
  RETURN
  ALERT
  SHIPPING
  CUSTOMER
  SYSTEM
}

// ====================== Auth & Customers ======================

model User {
  id                       String         @id @default(cuid())
  email                    String         @unique
  name                     String?
  phone                    String?
  passwordHash             String?
  status                   CustomerStatus @default(ACTIVE)
  avatar                   String?
  emailVerified            DateTime?
  verificationToken        String?
  verificationTokenExpires DateTime?
  resetToken               String?
  resetTokenExpires        DateTime?
  tokenVersion             Int            @default(0)
  addresses                Address[]
  orders                   Order[]
  reviews                  Review[]
  wishlist                 Wishlist[]
  cart                     Cart?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
}

model AdminUser {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id])
  status        AdminStatus    @default(ACTIVE)
  lastLogin     DateTime?
  tokenVersion  Int            @default(0)
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Role {
  id          String      @id @default(cuid())
  name        String      @unique
  permissions String[]
  admins      AdminUser[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// =========================== Catalog ===========================

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  image       String?
  description String?
  active      Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  logo        String?
  description String?
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String?
  price          Int
  originalPrice  Int?
  discount       Int              @default(0)
  stock          Int              @default(0)
  inStock        Boolean          @default(true)
  badge          String?
  rating         Float?
  ratingCount    Int              @default(0)
  colors         String[]
  features       String[]
  specifications Json?
  deliveryInfo   Json?
  warrantyInfo   Json?
  warranty       String?
  images         String[]
  sku            String?          @unique
  barcode        String?
  status         ProductStatus    @default(ACTIVE)
  shippingType   ShippingType     @default(FREE)
  shippingCost   Int              @default(0)
  featured       Boolean          @default(false)
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  brandId        String?
  brand          Brand?           @relation(fields: [brandId], references: [id])
  variants       ProductVariant[]
  reviews        Review[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  wishlists      Wishlist[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  inventoryItems InventoryItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProductVariant {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id])
  name      String
  price     Int?
  stock     Int        @default(0)
  sku       String?
  images    String[]   @default([])
  cartItems CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Review {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  rating    Int
  comment   String?
  helpful   Int          @default(0)
  status    ReviewStatus @default(APPROVED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// ====================== Cart & Wishlist =======================

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id])
  sessionId String?
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id])
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  phone     String
  address   String
  city      String
  zipCode   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================= Commerce ===========================

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  discountType    DiscountType
  discountValue   Int
  minimumOrder    Int          @default(0)
  maximumDiscount Int?
  usageLimit      Int?
  usedCount       Int          @default(0)
  expiryDate      DateTime?
  status          CouponStatus @default(ACTIVE)
  orders          Order[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Promotion {
  id            String                @id @default(cuid())
  name          String
  title         String?
  badge         String?
  description   String?
  type          PromotionType         @default(SALE)
  discountType  DiscountType
  discountValue Int                   @default(0)
  applicableTo  PromotionApplicableTo @default(ALL)
  startDate     DateTime?
  endDate       DateTime?
  status        PromotionStatus       @default(ACTIVE)
  ctaLabel      String?
  ctaHref       String?
  icon          String?
  gradient      String?
  sortOrder     Int                   @default(0)
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model Order {
  id              String           @id @default(cuid())
  userId          String?
  user            User?            @relation(fields: [userId], references: [id])
  customerName    String
  customerEmail   String?
  customerPhone   String
  shippingAddress String
  city            String?
  status          OrderStatus      @default(PENDING)
  paymentMethod   PaymentMethod    @default(CASH_ON_DELIVERY)
  paymentStatus   PaymentStatus    @default(PENDING)
  couponId        String?
  coupon          Coupon?          @relation(fields: [couponId], references: [id])
  subtotal        Int
  discount        Int              @default(0)
  shippingCost    Int              @default(0)
  total           Int
  note            String?
  items           OrderItem[]
  statusLogs      OrderStatusLog[]
  payments        Payment[]
  deliveries      Delivery[]
  returns         Return[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  variantId   String?
  productName String
  quantity    Int
  price       Int
  total       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

model Payment {
  id             String          @id @default(cuid())
  transactionId  String          @unique
  orderId        String          @unique
  order          Order?          @relation(fields: [orderId], references: [id])
  customerName   String
  amount         Int
  method         PaymentMethod
  status         PaymentStatus
  paymentGateway PaymentGateway?
  date           DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Delivery {
  id                String         @id @default(cuid())
  orderId           String?
  order             Order?         @relation(fields: [orderId], references: [id])
  customerName      String
  address           String
  city              String
  courier           String
  trackingNumber    String?
  status            DeliveryStatus
  shippingCost      Int            @default(0)
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Return {
  id           String       @id @default(cuid())
  orderId      String?
  order        Order?       @relation(fields: [orderId], references: [id])
  customerName String
  product      String
  reason       String
  status       ReturnStatus
  refundAmount Int          @default(0)
  requestDate  DateTime
  resolvedDate DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ================== Inventory & Procurement ===================

model Warehouse {
  id        String          @id @default(cuid())
  name      String          @unique
  location  String?
  inventory InventoryItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model InventoryItem {
  id            String          @id @default(cuid())
  productId     String?
  product       Product?        @relation(fields: [productId], references: [id])
  name          String
  sku           String?
  stock         Int             @default(0)
  minStock      Int             @default(0)
  maxStock      Int?
  status        InventoryStatus @default(IN_STOCK)
  lastRestocked DateTime?
  warehouseId   String?
  warehouse     Warehouse?      @relation(fields: [warehouseId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String?
  product     Product?          @relation(fields: [productId], references: [id])
  productName String?
  type        StockMovementType
  quantity    Int
  date        DateTime?
  reference   String?
  note        String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Supplier {
  id             String                @id @default(cuid())
  name           String
  phone          String?
  email          String?
  address        String?
  company        String?
  dueAmount      Int                   @default(0)
  totalPurchases Int                   @default(0)
  status         SupplierStatus        @default(ACTIVE)
  transactions   SupplierTransaction[]
  purchases      Purchase[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model SupplierTransaction {
  id         String                  @id @default(cuid())
  supplierId String
  supplier   Supplier                @relation(fields: [supplierId], references: [id])
  type       SupplierTransactionType
  amount     Int
  date       DateTime?
  reference  String?
  note       String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
}

model Purchase {
  id            String         @id @default(cuid())
  supplierId    String
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  items         PurchaseItem[]
  subtotal      Int            @default(0)
  discount      Int            @default(0)
  tax           Int            @default(0)
  total         Int
  paidAmount    Int            @default(0)
  dueAmount     Int            @default(0)
  status        PurchaseStatus @default(PENDING)
  date          DateTime?
  invoiceNumber String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id])
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  unitPrice   Int
  total       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ========================== Operations =========================

model Expense {
  id            String          @id @default(cuid())
  category      ExpenseCategory
  amount        Int
  description   String?
  date          DateTime?
  paymentMethod String?
  receipt       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Notification {
  id          String           @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser?       @relation(fields: [adminUserId], references: [id])
  title       String
  message     String
  type        NotificationType
  time        DateTime
  read        Boolean          @default(false)
  actionUrl   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// ============================= CMS =============================

model BlogPost {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String?
  category       String?
  tags           String[]
  author         String?
  publishedAt    DateTime?
  featuredImage  String?
  seoTitle       String?
  seoDescription String?
  status         PostStatus @default(PUBLISHED)
  blocks         Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Page {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String?
  status      PageStatus @default(PUBLISHED)
  lastUpdated DateTime?
  seo         Json?
  blocks      Json?
  content     Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model JobOpening {
  id               String           @id @default(cuid())
  title            String
  department       String?
  type             String?
  location         String?
  description      String?
  responsibilities String[]
  requirements     String[]
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  applications     JobApplication[]
}

model JobApplication {
  id          String     @id @default(cuid())
  jobId       String
  job         JobOpening @relation(fields: [jobId], references: [id])
  name        String
  email       String
  phone       String?
  coverLetter String?
  resume      String?
  status      String     @default("pending")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PosSession {
  id          String    @id @default(cuid())
  startTime   DateTime
  endTime     DateTime?
  totalSales  Int       @default(0)
  totalOrders Int       @default(0)
  cashInHand  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
