# Database
DATABASE_URL="postgresql://user:password@localhost:5432/unseen_gadget"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-32-plus-character-secret"

# Optional Social OAuth (Google / Facebook)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# JWT Authentication
JWT_SECRET="generate-a-random-32-plus-character-secret"
JWT_EXPIRES_IN="7d"

# API
API_URL="http://localhost:5000"
NEXT_PUBLIC_API_URL="http://localhost:5000"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"


# Admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
CUSTOMER_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
